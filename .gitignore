# 06.test-suite-and-ci-integration/scripts is the exercise's own workspace: readers fill
# it in themselves, so its files are never committed (answer/ holds the
# finished version) - but the folders stay, via tracked .gitkeep placeholders.
06.test-suite-and-ci-integration/scripts/*/*
!06.test-suite-and-ci-integration/scripts/*/.gitkeep

